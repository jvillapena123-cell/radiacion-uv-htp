rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquiera puede ver el informe UV publicado (pantallas, celulares, GitHub Pages)
    // Solo usuarios autenticados en Firebase Auth pueden publicar cambios
    match /uv/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /boletines/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /uv_historial/{fecha} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
